# Frontend API
REACT_APP_API_BASE_URL=/api

# OAuth는 브라우저 전체 이동이므로 CRA proxy를 거치지 않습니다.
# 배포 환경에서는 실제 백엔드 API 주소 또는 동일 출처의 /api로 설정합니다.
REACT_APP_AUTH_BASE_URL=http://localhost:8080/api

# auto: API 우선, 연결 실패 시 Mock 사용
# mock: Mock 데이터만 사용
# api: 실제 API만 사용
REACT_APP_DATA_MODE=auto

# 카카오맵 JavaScript 키
# 실제 키는 .env에만 입력하고 이 파일에는 올리지 않습니다.
KAKAO_MAP_KEY=
REACT_APP_KAKAO_MAP_KEY=${KAKAO_MAP_KEY}
